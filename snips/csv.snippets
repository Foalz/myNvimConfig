# Odoo: Cabecera obligatoria para ir.model.access.csv
snippet oaccess_header "Header ir.model.access.csv" b
id,name,model_id:id,group_id:id,perm_read,perm_write,perm_create,perm_unlink
endsnippet

# Odoo: Fila de permisos estándar (requiere grupo)
snippet oaccess_row "Row for ir.model.access.csv" b
access_${1:model_name}_${2:group},${3:description},model_${1:model_name},${4:base.group_user},${5:1},${6:0},${7:0},${8:0}
endsnippet

# Odoo: Fila de permisos totales (sin grupo específico, acceso global)
snippet oaccess_all "Row with full permissions" b
access_${1:model_name}_all,${1} all,model_${1:model_name},,1,1,1,1
endsnippet
